# ─────────────────────────────────────────────────────────────
# Each Spirit 環境変数サンプル
#
# 使い方:
#   1. このファイルを複製して .env.local を作成
#        (PowerShell)  Copy-Item .env.example .env.local
#        (bash)        cp .env.example .env.local
#   2. 各値を実値に置き換える
#   .env.local は git 管理外（コミット禁止）です。
# ─────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────
# プロジェクト: "each-spirit and drink-mgt" (ref: ctwpnaizwsrffrkkbuig)
NEXT_PUBLIC_SUPABASE_URL=https://ctwpnaizwsrffrkkbuig.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── On-demand ISR 再検証 ─────────────────────────────────────
# /api/revalidate の認証シークレット。任意の長いランダム文字列。
# 本番(Vercel)にも同じ値を環境変数として設定すること。
REVALIDATE_SECRET=your-random-secret

# seed 実行後に本番を自動再検証したい場合のみ設定（任意）
# 例: https://www.each-spirit.com/api/revalidate
# SITE_REVALIDATE_URL=

# ── 補足 ─────────────────────────────────────────────────────
# Google ログイン用の Client ID / Secret は Supabase ダッシュボード側に登録します。
# アプリ(.env)には不要です（Supabase が OAuth を仲介するため）。
